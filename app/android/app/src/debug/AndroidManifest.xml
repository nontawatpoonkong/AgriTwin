<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Development only: allows plain HTTP to the local API (http://10.0.2.2:8000 from the
         emulator, or the PC's LAN IP) for Android's own networking, e.g. WebView or
         platform HTTP clients. Dart's HTTP client (package:http on dart:io) does not check
         this flag, so even release builds can reach an http:// API_BASE_URL: use https
         in production. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
