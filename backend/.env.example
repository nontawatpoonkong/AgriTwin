# Copy to backend/.env  (Windows: copy .env.example .env). backend/.env is ignored by Git.
# Replace change-me with the POSTGRES_PASSWORD you set in infra/.env.
# Host port 5433 avoids clashing with a PostgreSQL you may already have installed on 5432.
DATABASE_URL=postgresql+psycopg://agritwin:change-me@localhost:5433/agritwin

MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_ENV=dev
# MQTT_USERNAME=
# MQTT_PASSWORD=

DEVICE_OFFLINE_AFTER_SECONDS=180
CORS_ALLOW_ORIGINS=*

# Only for pytest integration tests (a separate, disposable database):
TEST_DATABASE_URL=postgresql+psycopg://agritwin:change-me@localhost:5433/agritwin_test
